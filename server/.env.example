PORT=4000

# Postgres from docker-compose.yml (`npm run db:up`)
DATABASE_URL=postgres://atmo:atmo@localhost:5433/atmocare

# Clerk dashboard → API Keys. The publishable key is the same one the app uses.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Push notifications (AQI alerts + plant reminders)
JOBS_ENABLED=true
# Optional: only needed if you enable "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=
